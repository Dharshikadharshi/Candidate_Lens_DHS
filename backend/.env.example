# Copy to backend/.env and fill in your own values. Never commit backend/.env.
# Every value below is a placeholder.

PROJECT_NAME="CandidateLens"
API_V1_STR="/api"
SECRET_KEY="<your-secret-key>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="<token-lifetime-in-minutes>"
DATABASE_URL="postgresql://<db-user>:<db-password>@<db-host>:5432/<db-name>"
CORS_ORIGINS='["<frontend-url>"]'
FRONTEND_URL="<frontend-url>"

# Interviews (optional; defaults are used when omitted)
# INTERVIEW_JOIN_EARLY_MINUTES="<minutes>"
# INTERVIEW_GRACE_MINUTES="<minutes>"
# INTERVIEWER_ABSENT_SECONDS="<seconds>"
# INTERVIEWER_GONE_SECONDS="<seconds>"

# Video calls (LiveKit)
LIVEKIT_URL="<livekit-server-url>"
LIVEKIT_API_KEY="<your-livekit-api-key>"
LIVEKIT_API_SECRET="<your-livekit-api-secret>"
# VIDEO_TOKEN_TTL_MINUTES="<minutes>"

# AI assessment (OpenAI) - backend only, never in the frontend .env
OPENAI_API_KEY="<your-openai-api-key>"
OPENAI_MODEL="<your-openai-model>"
OPENAI_TRANSCRIPTION_MODEL="<your-transcription-model>"
# OPENAI_REASONING_EFFORT="<low|medium|high, or empty>"
# OPENAI_TIMEOUT_SECONDS="<seconds>"
# OPENAI_MAX_RETRIES="<count>"
# AI_PRICING_JSON='<json-price-table>'
# AI_DIMENSION_WEIGHTS_JSON='<json-weights>'
# AI_ROLE_PROFILES_PATH="<path-to-role-profiles.json>"
# AI_MAX_AUDIO_MB="<megabytes>"
# AI_MAX_AUDIO_SECONDS="<seconds>"
